---
import BaseLayout from '../layouts/BaseLayout.astro'
import SocialLinks from '../components/SocialLinks.astro'
---

<BaseLayout title="About — Bryan Loh" description="About Bryan Loh, software engineer.">
  <h1 class="text-3xl font-semibold text-slate-900 dark:text-slate-100 mb-8">About</h1>

  <div class="space-y-5 text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
    <p>
      I am a software engineer from Singapore currently pursuing a Master of Information Technology
      at the University of New South Wales (UNSW) in Sydney, specializing in cybersecurity under a
      scholarship program.
    </p>
    <p>
      My interests lie in cloud security and DevSecOps, and I am passionate about building secure,
      scalable systems while integrating security practices into modern software development
      workflows. I aspire to build a career in cybersecurity, focusing on securing cloud-native
      infrastructure and improving software security practices.
    </p>
    <p>Outside of work, I enjoy exploring nature an learning in general</p>
  </div>

  <!-- Now section -->
  <section class="mt-14">
    <h2
      class="text-xs font-medium tracking-widest uppercase text-slate-400 dark:text-slate-500 mb-5"
    >
      Now
    </h2>
    <ul class="space-y-3 text-slate-600 dark:text-slate-300">
      <li class="flex gap-2">
        <span class="text-indigo-600 dark:text-indigo-400 shrink-0">→</span>
        <span
          ><strong class="font-medium text-slate-800 dark:text-slate-200">Building:</strong> application
          hosted on AWS with automated deployment</span
        >
      </li>
      <li class="flex gap-2">
        <span class="text-indigo-600 dark:text-indigo-400 shrink-0">→</span>
        <span
          ><strong class="font-medium text-slate-800 dark:text-slate-200">Reading:</strong> Grit by Angela
          Duckworth</span
        >
      </li>
      <li class="flex gap-2">
        <span class="text-indigo-600 dark:text-indigo-400 shrink-0">→</span>
        <span
          ><strong class="font-medium text-slate-800 dark:text-slate-200">Learning:</strong> AWS Cloud
          Practioner Exam</span
        >
      </li>
    </ul>
  </section>

  <div class="mt-14 pt-8 border-t border-slate-100 dark:border-slate-800">
    <SocialLinks />
  </div>
</BaseLayout>
