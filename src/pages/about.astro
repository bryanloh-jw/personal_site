---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Bryan Loh" description="About Bryan Loh, Software Engineer.">
  <p class="text-amber-700 dark:text-amber-400 text-sm mb-8 opacity-80">$ cat about.md</p>

  <section class="mb-10">
    <h1 class="text-2xl md:text-3xl font-bold mb-6">About</h1>
    <div class="space-y-4 opacity-80 leading-relaxed max-w-xl">
      <p>
        Hi, I'm Bryan — a Software Engineer based in Singapore. I care about writing clean,
        maintainable code and building systems that work reliably at scale.
      </p>
      <p>
        When I'm not coding, I'm usually reading, writing, or thinking about how things work.
        This site is where I share what I learn.
      </p>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="text-amber-700 dark:text-amber-400 text-sm mb-4 opacity-80">$ tech-stack --list</h2>
    <div class="grid grid-cols-2 gap-2 max-w-sm text-sm opacity-70">
      <span>TypeScript / JavaScript</span>
      <span>Python</span>
      <span>React</span>
      <span>Node.js</span>
      <span>PostgreSQL</span>
      <span>Docker</span>
      <span>AWS / GCP</span>
      <span>Linux</span>
    </div>
  </section>

  <section>
    <h2 class="text-amber-700 dark:text-amber-400 text-sm mb-4 opacity-80">$ open links</h2>
    <div class="flex flex-col gap-2 text-sm">
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:underline">
        → github.com/bryanloh
      </a>
      <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:underline">
        → linkedin.com/in/bryanloh
      </a>
      <a href="mailto:bryanlohjw97@gmail.com" class="hover:underline">
        → bryanlohjw97@gmail.com
      </a>
    </div>
  </section>
</Layout>
