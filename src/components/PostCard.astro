---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  category: 'technical' | 'career';
  tags: string[];
}

const { title, description, date, slug, category, tags } = Astro.props;

const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="block border border-current/10 p-5 hover:border-amber-700 dark:hover:border-amber-400 transition-colors group">
  <div class="flex items-center gap-3 text-xs opacity-50 mb-2">
    <time datetime={date.toISOString()}>{formatted}</time>
    <span>/</span>
    <span>{category}</span>
  </div>
  <h2 class="font-bold text-base group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors mb-2">{title}</h2>
  <p class="text-sm opacity-60 leading-relaxed">{description}</p>
  {tags.length > 0 && (
    <div class="flex gap-2 mt-3 flex-wrap">
      {tags.map(tag => (
        <span class="text-xs opacity-40">#{tag}</span>
      ))}
    </div>
  )}
</a>
