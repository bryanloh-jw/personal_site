---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const links = [
  { href: '/blog', label: 'Blog' },
  { href: '/resume', label: 'Resume' },
  { href: '/about', label: 'About' },
];
---
<header class="py-5 border-b border-slate-100 dark:border-slate-800">
  <nav class="max-w-2xl mx-auto px-6 flex items-center justify-between">
    <a
      href="/"
      class="font-semibold text-slate-900 dark:text-slate-100 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
    >
      Bryan Loh
    </a>
    <div class="flex items-center gap-5">
      {links.map(({ href, label }) => {
        const isActive = currentPath === href || currentPath.startsWith(href + '/');
        return (
          <a
            href={href}
            class={`text-sm transition-colors ${
              isActive
                ? 'text-indigo-600 dark:text-indigo-400 font-medium'
                : 'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100'
            }`}
          >
            {label}
          </a>
        );
      })}
      <ThemeToggle />
    </div>
  </nav>
</header>
