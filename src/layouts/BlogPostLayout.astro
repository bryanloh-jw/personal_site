---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  date: Date
  tags: string[]
  readingTime: number
}

const { title, date, tags, readingTime } = Astro.props

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<BaseLayout title={`${title} — Bryan Loh`} description={title}>
  <article>
    <header class="mb-10">
      <h1 class="text-3xl font-semibold text-slate-900 dark:text-slate-100 leading-snug">
        {title}
      </h1>
      <div
        class="mt-3 flex items-center gap-3 flex-wrap text-sm text-slate-400 dark:text-slate-500"
      >
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>{readingTime} min read</span>
        {
          tags.length > 0 && (
            <>
              <span>·</span>
              <div class="flex items-center gap-2 flex-wrap">
                {tags.map((tag) => (
                  <a
                    href={`/blog/tag/${tag}`}
                    class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            </>
          )
        }
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="mt-16 pt-8 border-t border-slate-100 dark:border-slate-800">
      <a
        href="/blog"
        class="text-sm text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
      >
        ← Back to Writing
      </a>
    </footer>
  </article>
</BaseLayout>
